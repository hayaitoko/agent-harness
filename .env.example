# Copy this to .env and fill in real values. .env is gitignored.

# --- OpenRouter (primary inference backend) ---
# Every model call goes through OpenRouter. Provider pinning + ZDR
# enforcement live in artoo/runtime.py. Required.
OPENROUTER_API_KEY=

# --- Anthropic SDK (optional, vision-only fallback) ---
# Only consumed by artoo.runtime.anthropic_vision(), an optional
# direct-SDK path for multimodal turns. The default vision pipeline is
# OR-routed (openrouter_vision via google/gemini-3.1-flash-lite), so
# this is NOT needed for normal Telegram photo handling.
ANTHROPIC_API_KEY=
# Override the SDK-side vision model id if you call anthropic_vision()
# directly. Doesn't affect the OR-routed default path.
ANTHROPIC_VISION_MODEL=claude-sonnet-4-6

# --- Qdrant (memory store) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=artoo_memories

# --- Obsidian (human-readable mirror + link graph) ---
OBSIDIAN_VAULT=/path/to/your/vault

# --- Ollama (embeddings) ---
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=mxbai-embed-large
EMBED_DIM=1024

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_HOME_CHANNEL=    # optional: numeric chat_id for cron pushes

# --- Image generation (OpenRouter → google-vertex) ---
# Default model is Nano Banana 2 (Gemini 3.1 Flash Image). Routed through
# OpenRouter; no extra API key needed beyond OPENROUTER_API_KEY above.
# Override the model id by setting IMAGE_MODEL — anything Google ships on
# OpenRouter with image output works (e.g. google/gemini-3-pro-image-preview
# for Nano Banana Pro).
IMAGE_BACKEND=openrouter
IMAGE_MODEL=google/gemini-3.1-flash-image-preview

# --- Voice subsystem (optional, local backends by default) ---
# Install voice extras first: pip install -e ".[voice]"
# Backends are pluggable; current defaults are fully local (no API keys).
STT_BACKEND=whisper-local        # currently registered: whisper-local
TTS_BACKEND=piper-local          # currently registered: piper-local
WHISPER_MODEL=small              # tiny | base | small | medium | large
PIPER_VOICE=en_US-amy-medium     # see github.com/rhasspy/piper/blob/master/VOICES.md

# --- Browser harness (optional, used by /qa and browser_task tool) ---
# `browser-harness` is a third-party CLI that drives a headless Chrome
# over CDP. See systemd/chromium-harness.service for the companion unit.
# BROWSER_HARNESS_BIN=/usr/local/bin/browser-harness
# BU_CDP_URL=http://127.0.0.1:9222
# BU_NAME=artoo
# BROWSER_TASK_MODEL=anthropic/claude-sonnet-4.6

# --- Round pipeline ---
# Force the blob reviewer instead of the default tool-using one.
# ARTOO_REVIEWER=blob
# Override the safe root for the boss's `local` tool (defaults to repo).
# ARTOO_LOCAL_SAFE_ROOT=/home/youruser/artoo

# --- Data dir override (optional) ---
# ARTOO_DATA_DIR=/path/to/data

# --- Personalization (public-template knobs) ---
# These let one codebase serve both a private deploy and the public mirror.
# Leave them unset to run as a neutral template; set them to make your
# instance read naturally. None are required.
#
# Whose assistant is this? Feeds the persona + boss prompt ("the operator"
# by default). e.g. ARTOO_OWNER=Ada
# ARTOO_OWNER=
# owner/repo slug used in OpenRouter's HTTP-Referer + prompt examples.
# ARTOO_REPO_SLUG=youruser/artoo
# Full repo URL (defaults to https://github.com/$ARTOO_REPO_SLUG).
# ARTOO_REPO_URL=
# Override the entire persona string verbatim (highest-personalization knob).
# ARTOO_PERSONA=
